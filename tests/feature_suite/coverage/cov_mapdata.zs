global script LREx1Ex2ItemSwitch
{
	void run()
	{
		for(int f = 0; f < 10; ++f) Waitframe();
		o_mapdata = Game->LoadMapData(1, 0x14);
		Waitframe();
		{ untyped v = cvf_MAPDATAISSOLIDLYR_0(o_mapdata, 1, 1, 1); printf("C: MAPDATAISSOLIDLYR r %d\n", v); }
		Waitframe();
		{ untyped v = cvf_MAPDATAEXDOOR_1(o_mapdata, 1, 1); printf("C: MAPDATAEXDOOR r %d\n", v); }
		Waitframe();
