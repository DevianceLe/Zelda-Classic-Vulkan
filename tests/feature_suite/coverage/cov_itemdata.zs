global script LREx1Ex2ItemSwitch
{
	void run()
	{
		for(int f = 0; f < 10; ++f) Waitframe();
		o_itemdata = Game->LoadItemData(1);
		Waitframe();
		{ untyped v = cvr_IDATACOST2(o_itemdata); cvw_IDATACOST2(o_itemdata, v); printf("C: IDATACOST2 r %d w %d\n", v, cvr_IDATACOST2(o_itemdata)); }
		Waitframe();
		{ untyped v = cvr_IDATACOSTCOUNTER(o_itemdata); cvw_IDATACOSTCOUNTER(o_itemdata, v); printf("C: IDATACOSTCOUNTER r %d w %d\n", v, cvr_IDATACOSTCOUNTER(o_itemdata)); }
		Waitframe();
