+            {
+                std::string w2;
+                ret = zq_save_own_format_ex(argv[scene_arg+2], true, false, w2);
+                why += "; save " + w2;
+            }
+
+            FILE *out = fopen(argv[scene_arg+4], "w");
+
+            if(out)
+            {
+                fprintf(out, "%d %s\n", ret, why.c_str());
+                fclose(out);
+            }
+
+            exit(ret == 0 ? 0 : 3);
+        }
+
         // -qst-dump-cpools in.qst report.txt: the combo pools, autocombos and scrolling region
         // ids ZQuest holds for a 2.55.17 / 3.0 quest (zq_cpool.cpp; for testing their editors)
